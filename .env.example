PORT=3001
NODE_ENV=development
# Comma-separated list. Restart the server after changing .env (nodemon watches this file).
CORS_ORIGIN=http://localhost:3000

# Docker Postgres (npm run db:up) — port 5433 avoids conflict with Postgres.app on 5432
DATABASE_URL="postgresql://umt:umt@localhost:5433/umt_backend_test?schema=public"

# Postgres.app (local install, no Docker)
# DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/umt_backend_test?schema=public"

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=fireplaces
