{
  "openapi": "3.0.0",
  "info": {
    "title": "UMT Fireplace API",
    "version": "1.0.0",
    "description": "Backend API for the fireplace catalogue frontend"
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development"
    }
  ],
  "paths": {
    "/api/fireplace": {
      "get": {
        "summary": "Get paginated fireplace (product) list",
        "description": "Returns one page of products from the database. Use `page` and `per-page` to control pagination.",
        "tags": [ "Fireplace" ],
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PerPageParam" },
          { "$ref": "#/components/parameters/CategoryParam" }
        ],
        "responses": {
          "200": {
            "description": "Paginated product list with data and meta",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedFireplaceResponse" },
                "example": {
                  "data": [
                    {
                      "id": "1",
                      "img": "https://ftp.goit.study/img/fireplace/124925136a1003120787.png",
                      "title": "Лофт Кортен",
                      "desc": "Підвісна піч з кортенової сталі.",
                      "price": "33600",
                      "category": "standart"
                    }
                  ],
                  "meta": {
                    "first": 1,
                    "prev": null,
                    "next": 2,
                    "last": 9,
                    "pages": 9,
                    "items": 101
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a fireplace (product)",
        "tags": [ "Fireplace" ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FireplaceInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Fireplace created" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/fireplace/{id}": {
      "get": {
        "summary": "Get fireplace by id",
        "tags": [ "Fireplace" ],
        "parameters": [ { "$ref": "#/components/parameters/IdParam" } ],
        "responses": {
          "200": { "description": "Fireplace item" },
          "404": { "description": "Fireplace not found" }
        }
      },
      "patch": {
        "summary": "Partially update fireplace by id",
        "tags": [ "Fireplace" ],
        "parameters": [ { "$ref": "#/components/parameters/IdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FireplaceUpdate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Fireplace updated" },
          "400": { "description": "Validation error" },
          "404": { "description": "Fireplace not found" }
        }
      },
      "delete": {
        "summary": "Delete fireplace by id",
        "tags": [ "Fireplace" ],
        "parameters": [ { "$ref": "#/components/parameters/IdParam" } ],
        "responses": {
          "200": { "description": "Fireplace deleted" },
          "404": { "description": "Fireplace not found" }
        }
      }
    },
    "/api/feedback": {
      "get": {
        "summary": "Get all feedback",
        "tags": [ "Feedback" ],
        "responses": {
          "200": { "description": "Array of feedback items" }
        }
      },
      "post": {
        "summary": "Create feedback",
        "tags": [ "Feedback" ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FeedbackInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Feedback created" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/feedback/{id}": {
      "get": {
        "summary": "Get feedback by id",
        "tags": [ "Feedback" ],
        "parameters": [ { "$ref": "#/components/parameters/IdParam" } ],
        "responses": {
          "200": { "description": "Feedback item" },
          "404": { "description": "Feedback not found" }
        }
      },
      "patch": {
        "summary": "Partially update feedback by id",
        "tags": [ "Feedback" ],
        "parameters": [ { "$ref": "#/components/parameters/IdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FeedbackUpdate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Feedback updated" },
          "400": { "description": "Validation error" },
          "404": { "description": "Feedback not found" }
        }
      },
      "delete": {
        "summary": "Delete feedback by id",
        "tags": [ "Feedback" ],
        "parameters": [ { "$ref": "#/components/parameters/IdParam" } ],
        "responses": {
          "200": { "description": "Feedback deleted" },
          "404": { "description": "Feedback not found" }
        }
      }
    },
    "/api/order": {
      "get": {
        "summary": "Get all orders",
        "tags": [ "Order" ],
        "responses": {
          "200": { "description": "Array of order items" }
        }
      },
      "post": {
        "summary": "Create a new order",
        "tags": [ "Order" ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OrderInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Order created" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/order/{id}": {
      "get": {
        "summary": "Get order by id",
        "tags": [ "Order" ],
        "parameters": [ { "$ref": "#/components/parameters/IdParam" } ],
        "responses": {
          "200": { "description": "Order item" },
          "404": { "description": "Order not found" }
        }
      },
      "patch": {
        "summary": "Partially update order by id",
        "tags": [ "Order" ],
        "parameters": [ { "$ref": "#/components/parameters/IdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OrderUpdate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Order updated" },
          "400": { "description": "Validation error" },
          "404": { "description": "Order not found" }
        }
      },
      "delete": {
        "summary": "Delete order by id",
        "tags": [ "Order" ],
        "parameters": [ { "$ref": "#/components/parameters/IdParam" } ],
        "responses": {
          "200": { "description": "Order deleted" },
          "404": { "description": "Order not found" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "IdParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "minimum": 1 },
        "description": "Resource id"
      },
      "PageParam": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Page number (1-based)",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "example": 1
        }
      },
      "PerPageParam": {
        "name": "per-page",
        "in": "query",
        "required": false,
        "description": "Number of products per page",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 12,
          "example": 12
        }
      },
      "CategoryParam": {
        "name": "category",
        "in": "query",
        "required": false,
        "description": "Filter products by category. Omit to return all categories.",
        "schema": {
          "type": "string",
          "enum": [ "standart", "top" ],
          "example": "standart"
        }
      }
    },
    "schemas": {
      "Fireplace": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "1" },
          "img": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "desc": { "type": "string" },
          "price": { "type": "string", "example": "33600" },
          "category": { "type": "string", "enum": [ "standart", "top" ] }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "first": { "type": "integer", "example": 1 },
          "prev": { "type": [ "integer", "null" ], "example": null },
          "next": { "type": [ "integer", "null" ], "example": 2 },
          "last": { "type": "integer", "example": 9 },
          "pages": { "type": "integer", "example": 9 },
          "items": { "type": "integer", "example": 101, "description": "Total number of products matching the filter" }
        }
      },
      "PaginatedFireplaceResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Fireplace" }
          },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" }
        }
      },
      "FireplaceInput": {
        "type": "object",
        "required": [ "img", "title", "desc", "price", "category" ],
        "properties": {
          "img": { "type": "string", "format": "uri", "example": "https://example.com/fireplace.png" },
          "title": { "type": "string", "example": "Лофт Кортен" },
          "desc": { "type": "string", "example": "Підвісна піч з кортенової сталі." },
          "price": { "type": "string", "example": "33600" },
          "category": { "type": "string", "enum": [ "standart", "top" ], "example": "standart" }
        }
      },
      "FireplaceUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "img": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "desc": { "type": "string" },
          "price": { "type": "string" },
          "category": { "type": "string", "enum": [ "standart", "top" ] }
        }
      },
      "FeedbackInput": {
        "type": "object",
        "required": [ "rating", "text", "author", "location" ],
        "properties": {
          "rating": { "type": "integer", "minimum": 1, "maximum": 5, "example": 5 },
          "text": { "type": "string", "example": "Чудовий сервіс та якісний монтаж." },
          "author": { "type": "string", "example": "Олена Петренко" },
          "location": { "type": "string", "example": "м. Львів" }
        }
      },
      "FeedbackUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "text": { "type": "string" },
          "author": { "type": "string" },
          "location": { "type": "string" }
        }
      },
      "OrderInput": {
        "type": "object",
        "required": [ "name", "phone", "address" ],
        "properties": {
          "name": { "type": "string", "example": "Максим" },
          "phone": { "type": "string", "example": "+380991234567" },
          "address": { "type": "string", "example": "вул. Гетьмана Мазепи 15, Львів" },
          "comment": { "type": "string", "example": "Ваш коментар..." },
          "productId": {
            "type": [ "integer", "null" ],
            "example": 1,
            "description": "Product id when ordering from catalogue; null for general orders"
          }
        }
      },
      "OrderUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": { "type": "string" },
          "phone": { "type": "string" },
          "address": { "type": "string" },
          "comment": { "type": "string" },
          "productId": { "type": [ "integer", "null" ] }
        }
      }
    }
  }
}
